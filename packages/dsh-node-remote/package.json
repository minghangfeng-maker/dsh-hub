{
  "name": "@dsh-hub/dsh-node-remote",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "DSH Host 的薄 adapter：把 dsh-hub-mobile-v1/v2 帧翻成 HTTP unary + /api/remote.mux 流。Hub 与桌面共用，零 Hub 依赖。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pack": "pnpm pack"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
