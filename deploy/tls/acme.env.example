# 签发证书用的 acme.sh 环境（08 §3）。用法：
#   mkdir -p ~/.config/dsh-hub && cp deploy/tls/acme.env.example ~/.config/dsh-hub/acme.env
#   chmod 600 ~/.config/dsh-hub/acme.env && 填好下面几项
#
# 这个文件只在签发证书的机器上用：deploy/tls/issue-cert.sh 与 dsh-hub-cert.service 会 source 它，
# 里面的 DNS 凭据不会进 Hub 进程环境（Hub 只需要 secrets/tls/ 下的证书文件）。
#
# 凭据要求：用**只有该域名 DNS 权限**的子账号 / 最小权限令牌，别用主账号的全局 Key
# （对外服务的机器上不存证书私钥与 DNS 凭据——02 T9）。

# 要签的域名（A 记录指向这台机器的公网地址）
HUB_HOST=hub.example.com

# acme.sh 的 DNS 提供方插件（--dns 参数值，任选一个）：
#   dns_ali     Aliyun DNS   → Ali_Key / Ali_Secret
#   dns_cf      Cloudflare     → CF_Token（+ 可选 CF_Account_ID）
#   dns_dp      DNSPod        → DP_Id / DP_Key
#   dns_tencent Tencent Cloud DNS → TencentCloud_SecretId / TencentCloud_SecretKey
ACME_DNS=dns_ali

# ── 按 ACME_DNS 选一组填（其余留空/删掉） ────────────────────────────────────
# 云厂商：RAM 子账号，只授权 AliyunDNSFullAccess 且限定该域名
Ali_Key=
Ali_Secret=

# Cloudflare：只勾选该 Zone 的 DNS:Edit 权限
# CF_Token=
# CF_Account_ID=

# DNSPod
# DP_Id=
# DP_Key=

# Tencent Cloud DNS
# TencentCloud_SecretId=
# TencentCloud_SecretKey=

# 证书装到哪（默认 /srv/dsh-hub/secrets/tls，Hub 从那里热加载；改这里要同步改 dsh-hub 的 HUB_DATA_DIR）
HUB_DATA_DIR=/srv/dsh-hub

# 续期后让 Hub 热换证书（默认就是 dsh-hub.service；不用改）
# HUB_RELOAD_CMD="systemctl --user kill -s HUP dsh-hub.service"

# 可选：只给 acme.sh 用的 HTTP 代理。国内直连 Let's Encrypt API 不稳时打开（例如公司/机房出口的代理）：
# ACME_PROXY=http://proxy.example.com:3128
