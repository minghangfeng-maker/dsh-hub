# 每天检查一次证书续期（08 §3）。`RandomizedDelaySec=1h` 错开 Let's Encrypt 的高峰，
# `Persistent=true` 补上关机/漏跑时错过的运行；不依赖 crond。
# （在 WSL 上部署时：同样用 systemd timer，不要指望 crond。）
[Unit]
Description=Daily DSH Hub certificate renewal check

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=1h
Persistent=true
Unit=dsh-hub-cert.service

[Install]
WantedBy=timers.target
