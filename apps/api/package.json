{
  "name": "@dsh-hub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Hub 后端（Fastify + SQLite + Docker Engine API）",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "HUB_HTTP_PORT=7701 tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/db/migrations && mkdir -p dist/db/migrations && cp -R src/db/migrations/. dist/db/migrations/ && cp src/lib/weak-passwords.txt dist/lib/weak-passwords.txt",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dsh-hub/dsh-node-remote": "workspace:*",
    "@dsh-hub/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "archiver": "^7.0.1",
    "dockerode": "^4.0.12",
    "fastify": "^5.12.5",
    "qrcode-generator": "^2.0.4",
    "undici": "^8.12.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/dockerode": "^3.3.47",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.3.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "license": "Apache-2.0"
}
